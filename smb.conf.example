# Partage IMPRIMANTE - Si vous avez une imprimante USB
# Décommentez pour activer
# [printers]
#    comment = Toutes les imprimantes
#    browseable = no
#    path = /var/spool/samba
#    printable = yes
#    guest ok = yes
#    read only = yes
