#    strict allocate = yes
#    allocation roundup size = 4096

# Partage BACKUP - Pour les sauvegardes
# Décommentez et adaptez pour activer
# [Backup]
#    comment = Dossier de sauvegarde
#    path = /mnt/nas/backup
#    browseable = yes
