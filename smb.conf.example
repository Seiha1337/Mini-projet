#======================= Notes =======================
#
# Après modification de ce fichier :
# 1. Tester la configuration : testparm
# 2. Créer les dossiers nécessaires :
#    sudo mkdir -p /mnt/nas/partage /mnt/nas/private
# 3. Définir les permissions :
#    sudo chown -R nobody:nogroup /mnt/nas/partage
#    sudo chmod -R 0777 /mnt/nas/partage
#    sudo chown -R root:users /mnt/nas/private
#    sudo chmod -R 0770 /mnt/nas/private
# 4. Redémarrer Samba :
#    sudo systemctl restart smbd nmbd
# 5. Vérifier le statut :
#    sudo systemctl status smbd nmbd
#
# Pour ajouter un utilisateur :
#    sudo adduser nom_utilisateur
#    sudo usermod -aG users nom_utilisateur
#    sudo smbpasswd -a nom_utilisateur
#
# Pour tester l'accès :
#    Windows : \\raspinas\Partage
#    macOS   : smb://raspinas/Partage
#    Linux   : smb://raspinas/Partage
